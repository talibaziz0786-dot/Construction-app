# Copy to .env and configure for production.
# Variable names only — never commit real values.

# --- API ---
# Absolute URL of the deployed backend API (no trailing slash).
# Production example: https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:3000

# --- AdSense ---
# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# Leave empty to show placeholder ad slots.
VITE_ADSENSE_PUBLISHER_ID=

# Set to 'true' to render live AdSense ads (requires publisher ID above).
VITE_ADSENSE_ENABLED=false
