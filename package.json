{
  "name": "construction-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm test --workspace=server",
    "type-check": "npm run typecheck --workspace=server",
    "verify:phase2": "node verify-phase2.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@vitest/mocker": "4.1.12",
    "body-parser": "2.4.0",
    "vite": "8.2.4"
  }
}
