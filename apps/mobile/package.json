{
  "name": "construction-app-mobile",
  "description": "Cunstruction - Android-first construction calculator MVP. Server-authoritative: all calculations run through the shared Express API.",
  "license": "0BSD",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "@react-native-async-storage/async-storage": "~1.23.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.js",
    "offline:parity": "node scripts/offline-parity.js",
    "bundle:android": "expo export --platform android --output-dir dist"
  }
}